# Telegram Bot Settings
# Get your bot token from @BotFather on Telegram
BOT_TOKEN="your_bot_token_here"

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: For local development, use 'localhost' as the host
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salesbot_dev"

# Redis Connection
REDIS_URL="redis://localhost:6379"

# Server Settings
PORT=8000
NODE_ENV="development"

# Webhook Settings (Optional in development)
# For local development with ngrok or similar tunneling service
# Example: WEBHOOK_URL="https://your-subdomain.ngrok-free.app"
WEBHOOK_URL=""

# Admin Dashboard Settings
# Change this to a secure password
ADMIN_PASSWORD="admin"

# File Upload: Your personal Telegram chat ID or a private group chat ID.
# The bot will temporarily send uploaded files there to get a Telegram fileId.
# To find your ID: message @userinfobot on Telegram.
# Example: UPLOAD_CHAT_ID="123456789"
UPLOAD_CHAT_ID="your_upload_chat_id"

# OTP Verification Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=1
OTP_MAX_REQUESTS_PER_MINUTE=3
OTP_LENGTH=6

# File Storage Settings
# Options: local, s3
# For local development, 'local' is recommended
STORAGE_TYPE="local"
STORAGE_PATH="./uploads"

# AWS S3 Settings (required only if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
# Options: debug, info, warn, error
# Use 'debug' for development
LOG_LEVEL="debug"

# Security Settings
# Comma-separated list of allowed origins for CORS
# Example: ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"
ALLOWED_ORIGINS=""

# PostgreSQL Password (for Docker Compose)
# This must match the password in DATABASE_URL
POSTGRES_PASSWORD="postgres"
